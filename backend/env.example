# AI Service Configuration
# Copy this file to .env and fill in your API keys

# Replicate API (Recommended - easiest to use)
# Get your token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_token_here

# HeyGen API (Alternative for talking avatars)
# Get your key from: https://www.heygen.com/
HEYGEN_API_KEY=your_heygen_key_here

# D-ID API (Alternative for talking avatars)
# Get your key from: https://studio.d-id.com/
DID_API_KEY=your_did_key_here

# Hugging Face API (Alternative for both services)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Miragic Virtual Try-On API (Recommended for try-on)
# Get your key from: https://backend.miragic.ai/
MIRAGIC_API_KEY=your_miragic_api_key_here
# Optional: override defaults
MIRAGIC_BASE_URL=https://backend.miragic.ai
MIRAGIC_GARMENT_TYPE=full_body
# MIRAGIC_POLL_TIMEOUT_SECONDS=600

# Service Selection
# Options (virtual): miragic, replicate, huggingface, fallback
# Options (talking avatar): did, replicate, heygen, huggingface, fallback
VIRTUAL_TRYON_SERVICE=miragic
TALKING_AVATAR_SERVICE=did

